<?xml version="1.0" encoding="utf-8"?>
<!-- MVP note: only window-state-change events are needed to detect which app is
     in the foreground. Keep this minimal — broader event access is unnecessary
     and would be a red flag during Play Store accessibility-service review. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/app_name" />
