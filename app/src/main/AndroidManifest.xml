<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to know which app is in the foreground so we can gate it -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Lets us alert the parent if Accessibility/overlay protection gets turned off
         (ProtectionMonitor). Runtime-requested on API 33+; if never granted, the alert is
         simply skipped rather than crashing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The "scan a textbook photo" question-entry flow delegates to the device's own camera
         app (ActivityResultContracts.TakePicture), so no android.permission.CAMERA is needed —
         only that a camera exists, and even that's optional so the app still installs on
         camera-less devices/emulators. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Scoped visibility for the Gated Apps picker (InstalledAppsProvider): only sees
         apps that declare a launcher activity, same as the home-screen app drawer. This
         replaces the broader QUERY_ALL_PACKAGES special permission, which needs a Play
         Console declaration and store review to ship — <queries> doesn't. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets the TakePicture contract resolve the system camera app on API 30+, where
             package visibility is restricted by default. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".LearnToPlayApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share-to-app target (a parent sharing a teacher's WhatsApp text/image straight into
             question generation). Lives on an alias rather than directly on MainActivity so it
             can be switched off by resource: @bool/share_to_app_enabled mirrors
             FeatureFlags.AI_QUESTION_TOOLS, and is false in the MVP build, so the app simply
             doesn't appear in share sheets. The intent still lands in MainActivity when on. -->
        <activity-alias
            android:name=".ShareToAppAlias"
            android:targetActivity=".MainActivity"
            android:enabled="@bool/share_to_app_enabled"
            android:exported="true">
            <!-- Lets a parent share a teacher's WhatsApp message (or any other app's text)
                 straight into LearnToPlay's question-generation pipeline — see
                 MainActivity.extractPendingShare and util/SharedContentImport.kt. Two separate
                 filters (rather than one filter with two <data> mimeTypes) since text/plain and
                 image/* really are two distinct kinds of share this app handles differently. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>

        <!-- Detects foreground app changes; shows the quiz-gate overlay
             when a gated entertainment app is opened without a time-bank balance. -->
        <service
            android:name=".accessibility.AppLockAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Counts down the earned time bank while a gated app is in the foreground -->
        <service
            android:name=".service.TimeBankTrackerService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Hands a content:// Uri (instead of a raw file:// path) to the system camera app
             for the "scan a textbook photo" flow, scoped to just the scanned_questions/
             cache folder. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Device Owner hook (Tier 3 tamper-resistance). Only takes effect once set as
             Device Owner outside the app via adb — see AppDeviceAdminReceiver / TamperGuard. -->
        <receiver
            android:name=".admin.AppDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
        </receiver>

    </application>
</manifest>
